{
  "service": "Stalwart Mail Server",
  "version_pin": "0.16.15",
  "domain": "home.arpa",
  "listeners": {
    "smtp_submission": { "port": 587, "tls": "starttls-required", "authentication": "required" },
    "imaps": { "port": 993, "tls": "implicit-required", "authentication": "required" },
    "jmap": { "enabled": false, "tls": "required-if-enabled", "internal_only": true },
    "smtp_port_25": { "enabled": false },
    "pop3": { "enabled": false },
    "managesieve": { "enabled": false }
  },
  "recipient_policy": {
    "local_domain": "home.arpa",
    "unknown_local_recipient": "reject",
    "unauthenticated_submission": "reject",
    "external_recipients": "reject",
    "domain_allow_relaying": false
  },
  "fastmail": {
    "enabled": false,
    "host": "smtp.fastmail.com",
    "auth_username": "louis@poulin-arpa.com",
    "delivery_recipients": [
      "admin@poulin-arpa.com",
      "cluster_admin@poulin-arpa.com"
    ]
  }
}
