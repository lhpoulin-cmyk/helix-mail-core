#!/bin/sh
# Dispatch exactly one reviewed implementation packet to the dedicated worker.
set -eu

usage() { echo "usage: $0 [--dry-run] implementation/<packet>.packet.md" >&2; exit 2; }
dry_run=false
case "$#" in
  1) packet_input=$1 ;;
  2) [ "$1" = "--dry-run" ] || usage; dry_run=true; packet_input=$2 ;;
  *) usage ;;
esac
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "error: run from inside a Git worktree" >&2; exit 2; }
root=$(CDPATH= cd -- "$root" && pwd -P)
case "$packet_input" in /*) packet_candidate=$packet_input ;; *) packet_candidate=$root/$packet_input ;; esac
[ -f "$packet_candidate" ] || { echo "error: packet does not exist: $packet_input" >&2; exit 2; }
packet=$(CDPATH= cd -- "$(dirname -- "$packet_candidate")" && pwd -P)/$(basename -- "$packet_candidate")
case "$packet" in "$root"/implementation/*) ;; *) echo "error: packet must be inside $root/implementation" >&2; exit 2 ;; esac
case "$packet" in *'
'*) echo "error: packet path must not contain a newline" >&2; exit 2 ;; esac
packet_relative=${packet#"$root"/}

# Any tracked or non-ignored untracked change blocks dispatch and prevents
# concurrent edits. Only the two explicit ignored handoff files are allowed.
dirty=$(git status --porcelain --untracked-files=all)
[ -z "$dirty" ] || { echo "error: worktree is not clean; commit, remove, or explicitly ignore handoff-only files first" >&2; printf '%s\n' "$dirty" >&2; exit 1; }
ignored=$(git status --porcelain --ignored=matching --untracked-files=all | sed -n 's/^!! //p')
if [ -n "$ignored" ]; then
  while IFS= read -r ignored_path; do
    case "$ignored_path" in
      handoff/dispatch-state.env|handoff/worker-result.md) ;;
      *) echo "error: ignored non-handoff path blocks dispatch: $ignored_path" >&2; exit 1 ;;
    esac
  done <<EOF
$ignored
EOF
fi
# This is deliberately not configurable: dispatch is limited to the dedicated
# worker pane, never an arbitrary operator-selected tmux target.
target=mail-worker:0.0
tmux_bin=${TMUX_BIN:-tmux}
"$tmux_bin" list-panes -t "$target" -F '#{pane_id}' >/dev/null 2>&1 || { echo "error: tmux target does not exist: $target" >&2; exit 1; }
pane_command=$("$tmux_bin" display-message -p -t "$target" '#{pane_current_command}' 2>/dev/null || true)
pane_text=$("$tmux_bin" capture-pane -p -t "$target" -S -40 2>/dev/null || true)
case "$pane_command" in
  *codex*|*Codex*) worker_is_codex=true ;;
  *) if printf '%s\n' "$pane_text" | grep -qi 'codex'; then worker_is_codex=true; else worker_is_codex=false; fi ;;
esac
[ "$worker_is_codex" = true ] || { echo "error: tmux target does not appear to be running Codex: $target" >&2; exit 1; }
start_commit=$(git rev-parse --verify HEAD)
dispatch_epoch=$(date -u +%s)
dispatch_timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
instruction="Read AGENTS.md first. Execute only the packet at $packet_relative. Do not expand scope. Run required validation, commit the completed work, write the factual result to handoff/worker-result.md, and stop. Do not create the next packet or approve your own work."
printf 'packet: %s\n' "$packet_relative"
printf 'tmux target: %s\n' "$target"
printf 'starting commit: %s\n' "$start_commit"
printf 'dispatch timestamp: %s\n' "$dispatch_timestamp"
if [ "$dry_run" = true ]; then printf 'dry run: would paste one instruction through a temporary tmux buffer and send Enter\n'; exit 0; fi

umask 077
handoff_dir=$root/handoff
mkdir -p "$handoff_dir"
state_tmp=$(mktemp "$handoff_dir/.dispatch-state.XXXXXX")
buffer_tmp=$(mktemp "${TMPDIR:-/tmp}/helix-worker-dispatch.XXXXXX")
buffer_name="helix-worker-dispatch-$$"
cleanup() { rm -f "$state_tmp" "$buffer_tmp"; "$tmux_bin" delete-buffer -b "$buffer_name" >/dev/null 2>&1 || true; }
trap cleanup EXIT HUP INT TERM
{
  printf 'PACKET_PATH=%s\n' "$packet_relative"
  printf 'START_COMMIT=%s\n' "$start_commit"
  printf 'DISPATCH_EPOCH=%s\n' "$dispatch_epoch"
  printf 'DISPATCH_TIMESTAMP=%s\n' "$dispatch_timestamp"
  printf 'TMUX_TARGET=%s\n' "$target"
} >"$state_tmp"
mv "$state_tmp" "$handoff_dir/dispatch-state.env"
printf '%s\n' "$instruction" >"$buffer_tmp"
"$tmux_bin" load-buffer -b "$buffer_name" "$buffer_tmp"
"$tmux_bin" paste-buffer -b "$buffer_name" -d -t "$target"
"$tmux_bin" send-keys -t "$target" Enter
printf 'dispatched: %s\n' "$packet_relative"
