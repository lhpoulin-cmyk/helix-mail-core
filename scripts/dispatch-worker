#!/bin/sh
set -eu
usage(){ echo "usage: $0 [--dry-run] implementation/<packet>.packet.md" >&2; exit 2; }
dry=false
case "$#" in 1) input=$1;; 2) [ "$1" = --dry-run ] || usage; dry=true; input=$2;; *) usage;; esac
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo 'error: not a Git worktree' >&2; exit 2; }
root=$(CDPATH= cd -- "$root" && pwd -P)
case "$input" in /*) candidate=$input;; *) candidate=$root/$input;; esac
[ -f "$candidate" ] && [ ! -L "$candidate" ] || { echo "error: packet missing or symlinked: $input" >&2; exit 2; }
packet=$(readlink -f -- "$candidate")
case "$packet" in "$root"/implementation/*) ;; *) echo 'error: packet escapes implementation directory' >&2; exit 2;; esac
rel=${packet#"$root"/}
profile_declarations=$(grep -c '^HOST_EVIDENCE_PROFILE=' "$packet" || true)
case "$profile_declarations" in
  0) profile=;;
  1) profile=$(sed -n 's/^HOST_EVIDENCE_PROFILE=//p' "$packet")
     [ "$profile" = 'matriarch-libvirt-readonly-v1' ] || { echo 'error: unsupported HOST_EVIDENCE_PROFILE declaration' >&2; exit 2; };;
  *) echo 'error: packet has multiple HOST_EVIDENCE_PROFILE declarations' >&2; exit 2;;
esac
dirty=$(git status --porcelain --untracked-files=all)
[ -z "$dirty" ] || { echo 'error: dirty worktree' >&2; printf '%s\n' "$dirty" >&2; exit 1; }
ignored=$(git status --porcelain --ignored=matching --untracked-files=all | sed -n 's/^!! //p')
if [ -n "$ignored" ]; then while IFS= read -r p; do case "$p" in handoff/active-run|handoff/runs/) ;; *) echo "error: ignored non-runtime path: $p" >&2; exit 1;; esac; done <<EOF
$ignored
EOF
fi
active=$root/handoff/active-run
[ ! -e "$active" ] || { echo "error: active run: $(cat "$active")" >&2; exit 1; }
start=$(git rev-parse HEAD); run_id="$(date -u +%Y%m%dT%H%M%SZ)-$(git rev-parse --short HEAD)-$$"; run=$root/handoff/runs/$run_id; session="mail-worker-$run_id"
printf 'run ID: %s\ntmux session: %s\npacket: %s\nstarting commit: %s\nlog path: %s/worker.log\n' "$run_id" "$session" "$rel" "$start" "$run"
[ "$dry" = false ] || { echo 'dry run: would launch detached headless codex exec'; exit 0; }
umask 077; mkdir -p "$root/handoff/runs"; mkdir "$run" || exit 1
printf '%s\n' "$rel" >"$run/packet-path"; printf '%s\n' "$start" >"$run/start-commit"; date -u +%Y-%m-%dT%H:%M:%SZ >"$run/started-at"
[ -z "$profile" ] || printf '%s\n' "$profile" >"$run/host-evidence-profile"
cat >"$run/prompt.txt" <<EOF
You are the implementation worker for helix-mail-core.

Read AGENTS.md first.

Execute only the packet at:

    $rel

Starting commit:

    $start

Do not expand scope. The packet is the sole task authority. This packet permits read-only Fedora/KVM/libvirt inspection and repository modifications needed to record and render the inventory. It does not permit creation or mutation of a VM, libvirt domain, storage pool, network, NetworkManager configuration, DNS record, certificate, credential, package, service, or Fastmail configuration.

Run all required validation. Commit completed repository changes as one bounded implementation commit. Write the factual result to $run/worker-result.md including packet path, starting commit, ending commit, files changed, tests run, tests passed and failed, unresolved values, live-state observations and evidence timestamps, live mutation status, and exact stop reason if blocked.

Do not create the next packet. Do not approve your own work. Do not modify foreman doctrine. Stop after writing the result and exit.
EOF
printf '%s %s\n' "$run_id" "$session" >"$active.tmp"; mv "$active.tmp" "$active"
if ! tmux new-session -d -s "$session" -c "$root" env HELIX_RUN_DIR="$run" "$root/scripts/run-worker-headless"; then rm -f "$active"; echo 'error: tmux launch failed' >&2; exit 1; fi
printf 'dispatched: %s\n' "$run_id"
