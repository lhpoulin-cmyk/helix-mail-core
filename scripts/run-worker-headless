#!/bin/sh
# Codex execution path only.  Collection and all completion metadata belong to
# scripts/supervise-worker-headless, outside this process.
set -u
run=${1:-${HELIX_RUN_DIR:-}}
[ -n "$run" ] && [ -d "$run" ] || { echo 'error: invalid run directory' >&2; exit 2; }
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 2
root=$(CDPATH= cd -- "$root" && pwd -P)
exec codex exec --sandbox workspace-write --cd "$root" --ephemeral --color never -o "$run/codex-last-message.txt" - <"$run/prompt.txt"
