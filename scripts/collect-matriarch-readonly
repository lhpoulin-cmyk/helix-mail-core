#!/bin/sh
# Collect the fixed, metadata-only Matriarch profile.  This script deliberately
# has no packet, prompt, or command input: its identifiers and arguments below
# are the complete allowlist.
set -u

# Command lookup is deliberately independent of the caller's environment.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
test_root=
if [ "${1-}" = --test-command-root ]; then
  [ "$#" -eq 3 ] || { echo 'usage: --test-command-root /absolute/path RUN_EVIDENCE_DIRECTORY' >&2; exit 2; }
  test_root=$2
  case "$test_root" in /*) ;; *) echo 'error: test command root must be absolute' >&2; exit 2;; esac
  case "/$test_root/" in *'/../'*) echo 'error: test command root must not traverse' >&2; exit 2;; esac
  [ -d "$test_root" ] && [ ! -L "$test_root" ] || { echo 'error: test command root is missing or symlinked' >&2; exit 2; }
  resolved_test_root=$(readlink -f -- "$test_root") || exit 2
  [ "$resolved_test_root" = "$test_root" ] || { echo 'error: test command root is not canonical' >&2; exit 2; }
  shift 2
fi

profile=${HOST_EVIDENCE_PROFILE-}
[ "$profile" = "matriarch-libvirt-readonly-v1" ] || {
  echo 'error: unsupported host evidence profile' >&2
  exit 2
}
[ "$#" -eq 1 ] || { echo "usage: $0 RUN_EVIDENCE_DIRECTORY" >&2; exit 2; }
destination=$1
case "$destination" in /*) ;; *) echo 'error: evidence destination must be absolute' >&2; exit 2;; esac
parent=$(dirname -- "$destination")
[ -d "$parent" ] && [ ! -L "$parent" ] || { echo 'error: evidence parent is missing or symlinked' >&2; exit 2; }
resolved_parent=$(readlink -f -- "$parent") || exit 2
[ "$resolved_parent" = "$parent" ] || { echo 'error: evidence parent path is not canonical' >&2; exit 2; }
if [ -e "$destination" ] || [ -L "$destination" ]; then
  [ -d "$destination" ] && [ ! -L "$destination" ] && [ -z "$(find "$destination" -mindepth 1 -print -quit)" ] || {
    echo 'error: evidence destination is nonempty or unsafe' >&2
    exit 2
  }
else
  umask 077
  mkdir -- "$destination" || exit 2
fi

umask 077
LC_ALL=C
export LC_ALL

candidate() {
  case "$1" in
    hostnamectl|virsh|ip|bridge|nmcli|resolvectl|findmnt|systemctl) path=/usr/bin/$1;;
    cat|uname|date|test) path=/usr/bin/$1;;
    *) return 1;;
  esac
  [ -z "$test_root" ] || path=$test_root$path
  [ -x "$path" ] && printf '%s\n' "$path"
}

sanitize() {
  # Stable identifiers are not needed to establish the proposed construction
  # state. Keep query results useful while removing common MAC/UUID/serial forms.
  sed -E \
    -e 's/([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}/[MAC-REDACTED]/g' \
    -e 's/[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}/[UUID-REDACTED]/gi' \
    -e 's/([Ss]erial|[Uu]nique ID)[[:space:]]*[:=][[:space:]]*[^[:space:]]+/\1: [IDENTIFIER-REDACTED]/g'
}

record() {
  identifier=$1
  representation=$2
  command_name=$3
  shift 3
  sequence=$((sequence + 1))
  file=$(printf '%s/evidence-%02d-%s.txt' "$destination" "$sequence" "$identifier")
  stdout_tmp=$destination/.stdout-$sequence
  stderr_tmp=$destination/.stderr-$sequence
  started=$(/usr/bin/date -u +%Y-%m-%dT%H:%M:%SZ)
  command_path=$(candidate "$command_name" || true)
  if [ -n "$command_path" ]; then /usr/bin/timeout 15s "$command_path" "$@" >"$stdout_tmp" 2>"$stderr_tmp"; status=$?; else : >"$stdout_tmp"; printf 'fixed candidate unavailable: %s\n' "$command_name" >"$stderr_tmp"; status=127; fi
  finished=$(/usr/bin/date -u +%Y-%m-%dT%H:%M:%SZ)
  case "$status" in
    0) outcome=observed;;
    124) outcome=timed-out;;
    126|127) outcome=unavailable;;
    *) if rg -qi 'permission denied|operation not permitted|access denied|authorization failed' "$stderr_tmp" "$stdout_tmp"; then outcome=permission-denied; else outcome=failed; fi;;
  esac
  {
    printf 'command_identifier: %s\n' "$identifier"
    printf 'command: %s\n' "$representation"
    printf 'started_at_utc: %s\n' "$started"
    printf 'finished_at_utc: %s\n' "$finished"
    printf 'exit_status: %s\n' "$status"
    printf 'outcome: %s\n' "$outcome"
    [ -z "$test_root" ] || printf '%s\n' 'evidence_mode: test-only'
    printf '%s\n' '--- stdout ---'
    sanitize <"$stdout_tmp"
    printf '%s\n' '--- stderr ---'
    sanitize <"$stderr_tmp"
  } >"$file"
  rm -f -- "$stdout_tmp" "$stderr_tmp"
  return 0
}

sequence=0
# Host/Fedora/kernel/time state and the fixed system/session libvirt planes.
record hostnamectl 'hostnamectl' hostnamectl
record fedora-release 'cat /etc/fedora-release' cat /etc/fedora-release
record kernel 'uname -srmo' uname -srmo
record utc-time 'date -u +%Y-%m-%dT%H:%M:%SZ' date -u +%Y-%m-%dT%H:%M:%SZ
record dev-kvm 'test -e /dev/kvm' test -e /dev/kvm
record system-version 'virsh --readonly --connect qemu:///system version' virsh --readonly --connect qemu:///system version
record system-domains 'virsh --readonly --connect qemu:///system list --all' virsh --readonly --connect qemu:///system list --all
record system-networks 'virsh --readonly --connect qemu:///system net-list --all' virsh --readonly --connect qemu:///system net-list --all
record system-pools 'virsh --readonly --connect qemu:///system pool-list --all' virsh --readonly --connect qemu:///system pool-list --all
record session-version 'virsh --readonly --connect qemu:///session version' virsh --readonly --connect qemu:///session version
record session-domains 'virsh --readonly --connect qemu:///session list --all' virsh --readonly --connect qemu:///session list --all
record session-networks 'virsh --readonly --connect qemu:///session net-list --all' virsh --readonly --connect qemu:///session net-list --all
record session-pools 'virsh --readonly --connect qemu:///session pool-list --all' virsh --readonly --connect qemu:///session pool-list --all
# Unprivileged local network, resolver, mount, and libvirt service state.
record ip-link 'ip -brief link' ip -brief link
record ip-address 'ip -brief address' ip -brief address
record ip-route 'ip route' ip route
record bridge-link 'bridge link' bridge link
record nm-status 'nmcli general status' nmcli general status
record resolver-status 'resolvectl status' resolvectl status
record mount-state 'findmnt --kernel --output TARGET,SOURCE,FSTYPE,OPTIONS' findmnt --kernel --output TARGET,SOURCE,FSTYPE,OPTIONS
record libvirtd-status 'systemctl is-active libvirtd' systemctl is-active libvirtd
record virtqemud-status 'systemctl is-active virtqemud' systemctl is-active virtqemud

(
  cd -- "$destination" || exit 1
  sha256sum evidence-*.txt >manifest.sha256
)
printf '%s\n' 'host evidence collected'
