#!/bin/sh
set -eu
usage(){ echo "usage: $0 [--timeout seconds] [run-id]" >&2; exit 2; }
timeout=1800; run_id=
while [ "$#" -gt 0 ]; do case "$1" in --timeout) shift; [ "$#" -gt 0 ] || usage; timeout=$1;; *) [ -z "$run_id" ] || usage; run_id=$1;; esac; shift; done
case "$timeout" in *[!0-9]*|'') usage;; esac
root=$(git rev-parse --show-toplevel); runs=$root/handoff/runs
if [ -z "$run_id" ]; then run_id=$(find "$runs" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | tail -1); fi
run=$runs/$run_id; [ -d "$run" ] || { echo 'error: run not found' >&2; exit 2; }
start=$(cat "$run/start-commit"); session="mail-worker-$run_id"; deadline=$(( $(date +%s) + timeout ))
while [ ! -f "$run/exit-status" ] && [ "$(date +%s)" -le "$deadline" ]; do tmux has-session -t "$session" 2>/dev/null || { echo 'error: worker session vanished without exit status' >&2; exit 1; }; sleep 2; done
[ -f "$run/started-at" ] && [ -f "$run/failure-stage" ] && [ -f "$run/codex-exit-status" ] && [ -f "$run/finished-at" ] && [ -f "$run/exit-status" ] || { echo 'error: worker completion metadata is missing' >&2; exit 1; }
grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' "$run/started-at" "$run/finished-at" || { echo 'error: invalid worker timestamps' >&2; exit 1; }
grep -Eq '^[0-9]+$' "$run/exit-status" || { echo 'error: invalid worker exit status' >&2; exit 1; }
[ "$(cat "$run/exit-status")" = 0 ] || { echo "error: worker exited $(cat "$run/exit-status")" >&2; exit 1; }
[ "$(cat "$run/failure-stage")" = none ] || { echo 'error: successful worker has failure metadata' >&2; exit 1; }
[ "$(cat "$run/codex-exit-status")" = 0 ] || { echo 'error: successful worker has invalid Codex status' >&2; exit 1; }
[ -f "$run/worker-result.md" ] || { echo 'error: successful worker has no result' >&2; exit 1; }
parse_result_commit() {
  label=$1
  value=$(awk -v label="$label" '
    {
      prefix = "^[ \\t]*(-[ \\t]+)?" label ":"
      if ($0 ~ prefix) {
        candidate = $0
        sub(prefix, "", candidate)
        if (candidate ~ /^[ \\t]*[0-9a-f]+$/) {
          sub(/^[ \\t]*/, "", candidate)
          if (length(candidate) == 40) {
            count++
            commit = candidate
            next
          }
        }
        invalid = 1
      }
    }
    END {
      if (invalid || count != 1) exit 1
      print commit
    }
  ' "$run/worker-result.md") || {
    echo "error: result must contain exactly one full lowercase $label line" >&2
    exit 1
  }
  printf '%s\n' "$value"
}
reported=$(parse_result_commit 'Starting commit')
end=$(parse_result_commit 'Ending commit')
[ "$reported" = "$start" ] || { echo 'error: result starting commit mismatch' >&2; exit 1; }
git rev-parse --verify --quiet "$end^{commit}" >/dev/null || { echo 'error: invalid ending commit' >&2; exit 1; }
git merge-base --is-ancestor "$start" "$end" || { echo 'error: ending commit does not descend from start' >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=all)" ] || { echo 'error: worktree dirty after worker' >&2; exit 1; }
printf 'handoff ready for foreman review: %s\nending commit: %s\n' "$run_id" "$end"
